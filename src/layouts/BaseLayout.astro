---
import { CHRONOLOGY, ARTISTS, KEYWORDS } from '../data/index-terms.mjs';

export interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Editor mode = local `astro dev`. The deployed (built) site is always public mode.
const editor = import.meta.env.DEV;

// Flat list of auto-link targets for the in-prose term linker.
// Each: { aliases: string[], query: string, person?: boolean }  (label is always an alias)
// Terms flagged `noLink` (e.g. common words like "Contemporary") still appear on the
// index pages but are excluded from the in-prose auto-linker to avoid strange matches.
const termTargets = [
  ...CHRONOLOGY.map((t) => ({ aliases: [t.label, ...(t.aliases || [])], query: t.query || t.label, noLink: t.noLink })),
  ...ARTISTS.map((t) => ({ aliases: [t.label, ...(t.aliases || [])], query: t.query || t.label, person: true, noLink: t.noLink })),
  ...KEYWORDS.map((t) => ({ aliases: [t.label, ...(t.aliases || [])], query: t.query || t.label, noLink: t.noLink })),
].filter((t) => !t.noLink);
---

<!DOCTYPE html>
<html lang="en" class="notranslate" translate="no">
<head>
  <meta charset="UTF-8" />
  <meta name="google" content="notranslate" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <script is:inline>
    (function () {
      var f = localStorage.getItem('font-mode') || 'serif';
      document.documentElement.setAttribute('data-font', f);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Noto+Sans+JP:wght@300;400;500;600;700&family=Noto+Serif+JP:wght@400;500;600;700&family=Sora:wght@300;400;500;600;700&family=Google+Sans+Code:ital,wght@0,400;0,500;0,700;1,400&display=swap"
    rel="stylesheet"
  />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #ffffff;
      --fg: #343434;
      --fg-muted: #777777;
      --border: #e8e8e8;
      --link: rgb(49, 113, 222);
      --header-height: 60px;
      --font-sans: 'Sora', 'Noto Sans JP', sans-serif;
      --font-serif: 'Lora', 'Noto Serif JP', serif;
      --font-body: var(--font-sans);
      --font-code: 'Google Sans Code', 'Fira Mono', monospace;
    }
    html[data-font="serif"] { --font-body: var(--font-serif); }

    html, body {
      background: var(--bg);
      color: var(--fg);
      font-family: var(--font-body);
      font-size: 18px;
      line-height: 1.7;
      min-height: 100vh;
    }

    a { color: var(--link); text-decoration: none; }
    a:hover { opacity: 0.75; }

    /* ── Header (always-visible search) ───────────────────────────── */
    .topbar {
      font-family: var(--font-sans);
      position: fixed;
      top: 0; left: 0; right: 0;
      min-height: var(--header-height);
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0 1.25rem;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 100;
    }
    /* One uniform font size for every header control (nav, search, toggle). */
    .topbar { --header-fs: 0.85rem; }
    .topbar-left {
      display: flex;
      align-items: baseline;
      gap: 0.9rem;
      flex-shrink: 0;
    }
    .topnav { display: flex; gap: 0.9rem; }
    .topnav a { font-size: var(--header-fs); color: var(--fg-muted); white-space: nowrap; }
    .topnav a:hover { color: var(--fg); opacity: 1; }
    .topnav a.current { color: var(--fg); }

    .search-wrap { flex: 1; min-width: 0; }
    .search-input {
      width: 100%;
      font-family: inherit;
      font-size: var(--header-fs);
      color: var(--fg);
      background: transparent;
      border: none;
      border-bottom: 1px solid var(--border);
      padding: 0.4rem 0.1rem;
      outline: none;
      transition: border-color 0.15s;
    }
    .search-input:focus { border-color: var(--fg); }
    .search-input::placeholder { color: #bbb; }

    .topbar-font-switcher { display: flex; align-items: center; gap: 0.25rem; flex-shrink: 0; }
    .font-opt {
      background: none; border: none; cursor: pointer;
      padding: 0.2rem 0.1rem; font-size: var(--header-fs);
      color: var(--fg-muted); transition: color 0.15s;
    }
    .font-opt:hover { color: var(--fg); }
    .font-opt.active { color: var(--fg); font-weight: 600; }
    .font-sep { color: #ccc; font-size: var(--header-fs); user-select: none; }

    .main-wrap { margin-top: var(--header-height); }

    /* ── Search results view (replaces page content) ──────────────── */
    #search-view { max-width: 720px; margin: 0 auto; padding: 2.5rem 1.5rem 6rem; }
    .search-status {
      display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
      font-size: 0.8rem; color: var(--fg-muted); margin-bottom: 0.5rem;
    }
    .search-clear { background: none; border: none; cursor: pointer; color: var(--fg-muted); font-family: inherit; font-size: 0.8rem; }
    .search-clear:hover { color: var(--fg); }
    .results { list-style: none; }
    .result { padding: 1.5rem 0; border-top: 1px solid var(--border); }
    .result:first-child { border-top: none; }
    .result a.result-link { color: var(--fg); display: block; }
    .result a.result-link:hover { opacity: 1; color: var(--link); }
    .result-title { font-size: 1.15rem; font-weight: 500; letter-spacing: -0.01em; line-height: 1.3; }
    .result-title .ja { color: var(--fg-muted); font-weight: 400; margin-left: 0.5rem; font-size: 0.9em; }
    .result-summary {
      color: var(--fg-muted); font-size: 0.92rem; line-height: 1.6; margin-top: 0.4rem;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    .result-summary-ja {
      font-size: 0.86rem; margin-top: 0.3rem; color: #999; -webkit-line-clamp: 2;
    }
    .result-score { font-size: 0.72rem; color: #bbb; margin-top: 0.35rem; }

    /* ── Clickable term links inside prose ────────────────────────── */
    .term-link, .prose a.term-link {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px dotted #cfcfcf;
      cursor: pointer;
    }
    .term-link:hover, .prose a.term-link:hover { color: var(--link); border-bottom-color: var(--link); opacity: 1; }

    /* ── Doc pages (Editorial Policy, Writing Style) ──────────────── */
    .doc { max-width: 720px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
    .doc-title { font-size: 2.4rem; font-weight: 300; letter-spacing: -0.03em; line-height: 1.15; }
    .doc-title .ja { color: var(--fg-muted); font-size: 1.4rem; margin-left: 0.6rem; }
    .doc-intro { color: var(--fg-muted); font-size: 0.95rem; margin: 0.9rem 0 0; line-height: 1.7; }
    .doc-intro + .doc-intro { margin-top: 0.5rem; }
    .doc-intro-ja { margin-bottom: 2.5rem; }
    .doc h2 { font-size: 1.2rem; font-weight: 600; letter-spacing: -0.02em; margin-top: 2.5rem; margin-bottom: 0.9rem; }
    /* Bilingual heading pair: Japanese heading tucks under the English one, muted */
    .doc h2 + h2 { margin-top: -0.6rem; font-weight: 500; color: var(--fg-muted); }
    .doc p { margin-bottom: 1.3rem; }
    .doc ul, .doc ol { padding-left: 1.4rem; margin-bottom: 1.3rem; }
    .doc li { margin-bottom: 0.6rem; }
    .doc strong { font-weight: 600; }
    .doc em { font-style: italic; }
    .doc a { color: var(--link); }
    .doc hr { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }

    /* ── Site footer ──────────────────────────────────────────────── */
    .site-footer {
      max-width: 820px;
      margin: 3rem auto 0;
      padding: 1.5rem 1.5rem 2.5rem;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      font-size: 0.78rem;
      color: var(--fg-muted);
    }
    .site-footer nav { display: flex; gap: 1.1rem; flex-wrap: wrap; }
    .site-footer a { color: var(--fg-muted); }
    .site-footer a:hover { color: var(--fg); opacity: 1; }

    /* ── Editor mode (local dev only; never on the deployed site) ──── */
    :root { --editor: #d6336c; --editor-bg: #fff0f4; --editor-border: #f2aec5; }
    .editor-badge {
      position: fixed; top: 0; left: 0; right: 0; height: 26px; z-index: 200;
      display: flex; align-items: center; justify-content: center;
      background: var(--editor); color: #fff;
      font-family: var(--font-sans); font-size: 0.72rem; letter-spacing: 0.02em;
    }
    .editor-mode .topbar { top: 26px; }
    .editor-mode .main-wrap { margin-top: calc(var(--header-height) + 26px); }
    /* Draft marker — a small reddish-pink pill */
    .draft-badge {
      display: inline-block; vertical-align: middle;
      font-family: var(--font-sans); font-size: 0.62rem; font-weight: 600;
      letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--editor); background: var(--editor-bg);
      border: 1px solid var(--editor-border); border-radius: 4px;
      padding: 0.05rem 0.4rem;
    }
    /* Draft banner on an article page */
    .draft-banner {
      font-family: var(--font-sans); font-size: 0.82rem; color: var(--editor);
      background: var(--editor-bg); border: 1px solid var(--editor-border);
      border-radius: 6px; padding: 0.5rem 0.8rem; margin-bottom: 1.5rem;
    }
    /* Editor's note box */
    .editor-note {
      font-family: var(--font-sans); font-size: 0.85rem; line-height: 1.6;
      color: #7a2547; background: var(--editor-bg);
      border: 1px solid var(--editor-border); border-left: 3px solid var(--editor);
      border-radius: 6px; padding: 0.7rem 0.9rem; margin: 0 0 1.75rem;
    }
    .editor-note .editor-note-label {
      display: block; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--editor); margin-bottom: 0.3rem;
    }
    .editor-note p { margin: 0.3rem 0 0; }

    @media (max-width: 680px) {
      .topbar { flex-wrap: wrap; padding: 0.5rem 1rem; gap: 0.5rem 0.9rem; }
      .search-wrap { order: 3; flex-basis: 100%; }
    }
  </style>
</head>
<body class={editor ? 'editor-mode' : ''}>
  {editor && <div class="editor-badge">✎ Editor mode — drafts &amp; notes are visible here, never on the public site</div>}
  <header class="topbar">
    <div class="topbar-left">
      <nav class="topnav">
        <a href={base || '/'}>Home</a>
        <a href={`${base}/chronology`}>Chronology</a>
        <a href={`${base}/people`}>People</a>
        <a href={`${base}/keyword`}>Keywords</a>
      </nav>
    </div>
    <div class="search-wrap">
      <input id="q" class="search-input" type="text" autocomplete="off"
        placeholder="Search by idea, movement, artist, or feeling…" data-base={base} />
    </div>
    <div class="topbar-font-switcher">
      <button class="font-opt" id="font-btn-serif" style="font-family:'Lora','Noto Serif JP',serif">Serif</button>
      <span class="font-sep">|</span>
      <button class="font-opt" id="font-btn-sans" style="font-family:'Sora','Noto Sans JP',sans-serif">Sans</button>
    </div>
  </header>

  <main class="main-wrap">
    <div id="page-view"><slot /></div>
    <div id="search-view" hidden></div>
  </main>

  <footer class="site-footer">
    <span>Art and World History · 芸術と世界史</span>
    <nav>
      <a href={`${base}/policy`}>Editorial policy</a>
      <a href={`${base}/style`}>Writing style</a>
      <a href={`${base}/changes`}>Changes</a>
      <a href={`${base}/chronology`}>Chronology</a>
      <a href={`${base}/people`}>People</a>
      <a href={`${base}/keyword`}>Keywords</a>
    </nav>
  </footer>

  <script id="term-data" type="application/json" set:html={JSON.stringify(termTargets)}></script>

  <script>
    // ── Font switcher ────────────────────────────────────────────
    const FONT_KEY = 'font-mode';
    const btnSerif = document.getElementById('font-btn-serif')!;
    const btnSans = document.getElementById('font-btn-sans')!;
    function applyFont(mode: string) {
      document.documentElement.setAttribute('data-font', mode);
      localStorage.setItem(FONT_KEY, mode);
      btnSerif.classList.toggle('active', mode === 'serif');
      btnSans.classList.toggle('active', mode === 'sans');
    }
    applyFont(localStorage.getItem(FONT_KEY) || 'serif');
    btnSerif.addEventListener('click', () => applyFont('serif'));
    btnSans.addEventListener('click', () => applyFont('sans'));
  </script>

  <script>
    // ── Global semantic search (works on every page) ─────────────
    import { pipeline } from 'https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.2';

    const input = document.getElementById('q') as HTMLInputElement;
    const base = input.dataset.base || '';
    const pageView = document.getElementById('page-view')!;
    const searchView = document.getElementById('search-view')!;

    let articles: any[] = [];
    let indexLoaded: Promise<void> | null = null;
    let extractor: any = null;
    let modelLoading: Promise<any> | null = null;

    function splitTitle(title: string) {
      const m = title.match(/[぀-鿿＀-￯]/);
      if (!m || m.index === undefined) return { en: title, ja: '' };
      const lastSpace = title.lastIndexOf(' ', m.index - 1);
      if (lastSpace === -1) return { en: title, ja: '' };
      return { en: title.slice(0, lastSpace).trim(), ja: title.slice(lastSpace + 1).trim() };
    }
    function cosine(a: number[], b: number[]) {
      let dot = 0, na = 0, nb = 0;
      for (let i = 0; i < a.length; i++) { dot += a[i] * b[i]; na += a[i] * a[i]; nb += b[i] * b[i]; }
      return dot / (Math.sqrt(na) * Math.sqrt(nb) || 1);
    }
    function loadIndex() {
      if (!indexLoaded) {
        indexLoaded = fetch(`${base}/search-index.json`).then((r) => r.json()).then((d) => { articles = d; });
      }
      return indexLoaded;
    }
    async function ensureModel() {
      if (extractor) return extractor;
      if (!modelLoading) modelLoading = pipeline('feature-extraction', 'Xenova/all-MiniLM-L6-v2');
      extractor = await modelLoading;
      return extractor;
    }
    async function embed(text: string): Promise<number[]> {
      const model = await ensureModel();
      const out = await model(text, { pooling: 'mean', normalize: true });
      return Array.from(out.data as Float32Array);
    }

    function showPage() {
      searchView.hidden = true;
      pageView.hidden = false;
    }
    function render(query: string, list: any[]) {
      const items = list.map((a) => {
        const { en, ja } = splitTitle(a.title);
        const score = a.score != null ? `<div class="result-score">${Math.min(99, Math.round(a.score * 100))}% match</div>` : '';
        const summaryJa = a.summaryJa ? `<div class="result-summary result-summary-ja">${a.summaryJa}</div>` : '';
        const draftBadge = a.draft ? '<span class="draft-badge">Draft</span> ' : '';
        return `<li class="result"><a class="result-link" href="${base}/articles/${a.slug}">
          <div class="result-title">${draftBadge}${en}${ja ? `<span class="ja">${ja}</span>` : ''}</div>
          <div class="result-summary">${a.summary}</div>${summaryJa}${score}
        </a></li>`;
      }).join('');
      searchView.innerHTML = `
        <div class="search-status">
          <span>${list.length} result${list.length === 1 ? '' : 's'} for “${query}”</span>
          <button class="search-clear" id="search-clear">Clear ✕</button>
        </div>
        <ul class="results">${items || '<li class="result">No matching essays.</li>'}</ul>`;
      document.getElementById('search-clear')!.addEventListener('click', clearSearch);
      pageView.hidden = true;
      searchView.hidden = false;
    }
    function clearSearch() {
      input.value = '';
      showPage();
      window.scrollTo(0, 0);
    }

    async function runSearch(query: string) {
      const q = query.trim();
      if (!q) { showPage(); return; }
      await loadIndex();
      searchView.innerHTML = `<div class="search-status"><span>Searching “${q}”… (first search loads a small model)</span></div>`;
      pageView.hidden = true;
      searchView.hidden = false;
      const vec = await embed(q);
      // Hybrid ranking: semantic similarity + a lexical full-text boost, so an essay
      // that actually names the term (person, movement, year) always surfaces even if
      // the name isn't reflected in its short embedded summary.
      const ql = q.toLowerCase();
      const tokens = ql.split(/\s+/).filter((w) => w.length > 1);
      const ranked = articles
        .map((a) => {
          const sem = cosine(vec, a.vector);
          const t = a.text || '';
          let lex = 0;
          if (t.includes(ql)) lex = 1;
          else if (tokens.length && tokens.every((w) => t.includes(w))) lex = 0.7;
          return { ...a, score: sem + 0.5 * lex };
        })
        .filter((a) => a.score > 0.18)
        .sort((x, y) => y.score - x.score);
      render(q, ranked);
    }

    // Public entry point for clickable words anywhere on the page.
    (window as any).artSearch = (query: string) => {
      input.value = query;
      window.scrollTo(0, 0);
      runSearch(query);
    };

    let timer: any;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => runSearch(input.value), 220);
    });
    // Any element carrying data-search triggers a search.
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest('[data-search]') as HTMLElement | null;
      if (!t) return;
      e.preventDefault();
      (window as any).artSearch(t.getAttribute('data-search') || t.textContent || '');
    });

    // Preload the index so first search is snappy.
    loadIndex();
  </script>

  <script>
    // ── In-prose term auto-linker ────────────────────────────────
    // Wraps the first occurrence of each known term inside .prose in a clickable
    // link that triggers a semantic search. Runs once on load.
    (function () {
      const prose = document.querySelector('.prose');
      if (!prose) return;
      const dataEl = document.getElementById('term-data');
      if (!dataEl) return;
      const targets: { aliases: string[]; query: string; person?: boolean }[] =
        JSON.parse(dataEl.textContent || '[]');

      const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const isKatakana = (ch: string) => ch >= '゠' && ch <= 'ヿ';

      // Build matcher list. Latin aliases match case-insensitively with letter
      // boundaries (so "Pop art" matches the label "Pop Art"), except all-caps
      // acronyms (BIG, OMA, AKIRA) which stay case-sensitive to avoid matching
      // common words. Japanese person aliases extend across the katakana run so a
      // surname match grows to the full name (ニューマン → バーネット・ニューマン).
      type Matcher = { query: string; person: boolean; latin: boolean; alias: string; re?: RegExp };
      const matchers: Matcher[] = [];
      for (const t of targets) {
        for (const alias of t.aliases) {
          if (!alias || alias.length < 2) continue;
          const latin = /[A-Za-z]/.test(alias);
          const m: Matcher = { query: t.query, person: !!t.person, latin, alias };
          if (latin) {
            const flags = alias === alias.toUpperCase() ? '' : 'i'; // acronyms stay case-sensitive
            m.re = new RegExp('(?<![A-Za-z])' + escapeRe(alias) + '(?![A-Za-z])', flags);
          }
          matchers.push(m);
        }
      }

      const linked = new Set<string>(); // link each term at most once per page

      // Earliest match in `text` among ALL terms (linked or not); ties → longer wins.
      // We consider already-linked terms too so a compound span (e.g. 抽象表現主義)
      // is recognized and consumed as a whole instead of being shredded into the
      // sub-terms it contains (抽象 + 表現主義).
      function findMatch(text: string): { idx: number; len: number; query: string } | null {
        let best: { idx: number; len: number; query: string } | null = null;
        for (const m of matchers) {
          let idx = -1;
          let len = m.alias.length;
          if (m.latin) {
            const mm = m.re!.exec(text);
            if (mm) { idx = mm.index; len = mm[0].length; }
          } else {
            idx = text.indexOf(m.alias);
            if (idx !== -1 && isKatakana(m.alias[0]) && isKatakana(text[idx + len])) {
              // Reject a partial match sitting inside a longer katakana word —
              // リベラ inside リベラル, アニメ inside アニメーション. This applies to
              // every katakana alias, not only person names.
              idx = -1;
            } else if (idx !== -1 && m.person && isKatakana(m.alias[0])) {
              // Extend LEFT across the katakana run to absorb a preceding given
              // name (ニューマン → バーネット・ニューマン).
              let s = idx;
              while (s > 0 && isKatakana(text[s - 1])) s--;
              len = idx + len - s;
              idx = s;
            } else if (idx !== -1 && '的化性家派'.includes(text[idx + len] || '')) {
              // Avoid partial-word matches like 具体 inside 具体的, 抽象 inside 抽象化.
              idx = -1;
            }
          }
          if (idx === -1) continue;
          if (!best || idx < best.idx || (idx === best.idx && len > best.len)) {
            best = { idx, len, query: m.query };
          }
        }
        return best;
      }

      // Collect candidate text nodes (skip headings, existing links, buttons).
      const walker = document.createTreeWalker(prose, NodeFilter.SHOW_TEXT, {
        acceptNode(node) {
          const p = node.parentElement;
          if (!p) return NodeFilter.FILTER_REJECT;
          if (p.closest('a, h1, h2, h3, button, .term-link, .footnotes')) return NodeFilter.FILTER_REJECT;
          if (!node.textContent || !node.textContent.trim()) return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        },
      });
      const textNodes: Text[] = [];
      let n: Node | null;
      while ((n = walker.nextNode())) textNodes.push(n as Text);

      for (const node of textNodes) {
        let remaining = node.textContent || '';
        const frag = document.createDocumentFragment();
        let guard = 0;
        while (true) {
          const best = findMatch(remaining);
          if (!best || ++guard > 500) {
            if (remaining) frag.appendChild(document.createTextNode(remaining));
            break;
          }
          const before = remaining.slice(0, best.idx);
          const hit = remaining.slice(best.idx, best.idx + best.len);
          if (before) frag.appendChild(document.createTextNode(before));
          if (!linked.has(best.query)) {
            // First occurrence of this term → make it a clickable link.
            const a = document.createElement('a');
            a.className = 'term-link';
            a.setAttribute('data-search', best.query);
            a.setAttribute('href', '#');
            a.textContent = hit;
            frag.appendChild(a);
            linked.add(best.query);
          } else {
            // Already linked elsewhere → keep as plain text (but consume the span
            // so its sub-terms don't get linked inside it).
            frag.appendChild(document.createTextNode(hit));
          }
          remaining = remaining.slice(best.idx + best.len);
        }
        node.replaceWith(frag);
      }
    })();
  </script>
</body>
</html>
