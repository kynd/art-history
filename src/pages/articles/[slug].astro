---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFile } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await doc.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Load precomputed related list (generated by scripts/build-index.mjs).
let related: any[] = [];
try {
  const p = fileURLToPath(new URL('../../../public/related.json', import.meta.url));
  const all = JSON.parse(await readFile(p, 'utf8'));
  related = all[doc.slug] || [];
} catch {}

function splitTitle(title: string): { en: string; ja: string } {
  const m = title.match(/[぀-鿿＀-￯]/);
  if (!m || m.index === undefined) return { en: title, ja: '' };
  const lastSpace = title.lastIndexOf(' ', m.index - 1);
  if (lastSpace === -1) return { en: title, ja: '' };
  return { en: title.slice(0, lastSpace).trim(), ja: title.slice(lastSpace + 1).trim() };
}

const { en: titleEn, ja: titleJa } = splitTitle(doc.data.title);

const fmtDate = (d: Date | undefined) => (d ? d.toISOString().slice(0, 10) : null);
const updatedStr = fmtDate(doc.data.updated);
---

<BaseLayout title={doc.data.title}>
  <div class="article-shell">
    <article class="prose">
      <p class="back"><a href={base || '/'}>← All essays</a></p>
      <h1 class="page-title">
        <span class="title-en">{titleEn}</span>
        {titleJa && <span class="title-ja">{titleJa}</span>}
      </h1>
      {updatedStr && <p class="page-meta">Updated {updatedStr}</p>}
      <Content />
    </article>

    <aside class="related">
      <h2 class="related-head">Related</h2>
      <ul>
        {related.map((r) => {
          const { en, ja } = splitTitle(r.title);
          return (
            <li>
              <a href={`${base}/articles/${r.slug}`}>
                <span class="related-title">{en}</span>
                {ja && <span class="related-ja">{ja}</span>}
              </a>
              <p class="related-summary">{r.summary}</p>
            </li>
          );
        })}
      </ul>
    </aside>
  </div>
</BaseLayout>

<style is:global>
  .article-shell {
    display: grid;
    grid-template-columns: minmax(0, 720px) 260px;
    gap: 4rem;
    justify-content: center;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 2rem 6rem;
    align-items: start;
  }

  .back { font-size: 0.8rem; margin-bottom: 2rem; }
  .back a { color: var(--fg-muted); }
  .back a:hover { color: var(--fg); }

  .prose .page-title {
    font-size: 2.6rem;
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 2.5rem;
  }
  .prose .page-title .title-en, .prose .page-title .title-ja { display: block; }
  .prose .page-title .title-ja { margin-top: 0.25em; font-size: 1.25rem; color: var(--fg-muted); }
  .prose .page-title { margin-bottom: 0.7rem; }
  .prose .page-meta { font-size: 0.78rem; color: var(--fg-muted); margin-bottom: 2.5rem; }

  .prose h2 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
  }
  /* Bilingual heading pair: pull the Japanese heading up under the English one */
  .prose h2 + h2 {
    margin-top: -0.7rem;
    font-weight: 500;
    color: var(--fg-muted);
  }
  .prose p { margin-bottom: 1.5rem; }
  .prose a { color: var(--link); }
  .prose strong { font-weight: 600; }
  .prose em { font-style: italic; }
  .prose ul, .prose ol { padding-left: 1.5rem; margin-bottom: 1.5rem; }
  .prose li { margin-bottom: 0.5rem; }
  .prose sup { font-size: 0.7em; vertical-align: super; line-height: 0; color: var(--fg-muted); }

  /* Footnotes / references */
  .prose .footnotes {
    font-size: 0.82rem;
    color: var(--fg-muted);
    border-top: 1px solid var(--border);
    margin-top: 1.75rem;
    padding-top: 1rem;
    line-height: 1.6;
  }
  .prose .footnotes li { margin-bottom: 0.5rem; }
  .prose .footnotes a { color: var(--fg-muted); text-decoration: underline; }
  .prose .footnotes a:hover { color: var(--fg); }

  /* Related side column */
  .related {
    position: sticky;
    top: calc(var(--header-height) + 1rem);
    border-top: 2px solid var(--fg);
    padding-top: 0.9rem;
  }
  .related-head {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
    font-weight: 600;
    margin-bottom: 1.1rem;
  }
  .related ul { list-style: none; }
  .related li { margin-bottom: 1.35rem; }
  .related a { color: var(--fg); display: block; }
  .related a:hover { opacity: 1; color: var(--link); }
  .related-title { font-size: 0.9rem; font-weight: 500; line-height: 1.35; display: block; }
  .related-ja { font-size: 0.78rem; color: var(--fg-muted); display: block; margin-top: 0.15rem; }
  .related-summary {
    font-size: 0.78rem;
    color: var(--fg-muted);
    line-height: 1.5;
    margin-top: 0.35rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .article-shell { grid-template-columns: minmax(0, 1fr); gap: 3rem; }
    .related { position: static; }
  }
</style>
